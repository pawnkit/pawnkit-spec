{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pawnkit.dev/pawn-runtime-index/v1/schema.json",
  "title": "Pawn server runtime artifact index",
  "description": "Reviewed server runtime downloads and the hashes needed to install them.",
  "type": "object",
  "required": ["schemaVersion", "id", "generatedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target": {
      "type": "string",
      "pattern": "^(linux|windows|darwin)-(amd64|arm64|386)$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9$][A-Za-z0-9$_.-]*(?:/[A-Za-z0-9$][A-Za-z0-9$_.-]*)*$"
    },
    "source": {
      "type": "object",
      "required": ["repository", "tag", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "archive": {
      "type": "object",
      "required": ["url", "format", "size", "checksum"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/]+/[^/]+$"
        },
        "format": {
          "type": "string",
          "enum": ["zip", "tar.gz"]
        },
        "size": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": ["path", "architecture", "checksum"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "architecture": {
          "type": "string",
          "enum": ["386", "amd64", "arm64"]
        },
        "checksum": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "vendor",
        "version",
        "profile",
        "target",
        "source",
        "archive",
        "root",
        "executable"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "enum": ["openmultiplayer", "samp"]
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "profile": {
          "type": "string",
          "enum": ["samp-037", "openmp"]
        },
        "target": { "$ref": "#/$defs/target" },
        "source": { "$ref": "#/$defs/source" },
        "archive": { "$ref": "#/$defs/archive" },
        "root": { "$ref": "#/$defs/relativePath" },
        "executable": { "$ref": "#/$defs/executable" }
      },
      "additionalProperties": false
    }
  }
}
