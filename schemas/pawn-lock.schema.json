{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pawnkit.dev/pawn-lock/v1/schema.json",
  "title": "Pawn lockfile (pawn.lock)",
  "description": "The sampctl-compatible dependency, runtime, and build lockfile.",
  "oneOf": [
    { "$ref": "#/$defs/sampctlLock" },
    { "$ref": "#/$defs/legacyPawnKitLock" }
  ],
  "$defs": {
    "sampctlLock": {
      "type": "object",
      "required": ["version", "generated", "sampctl_version", "dependencies"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "generated": { "type": "string", "format": "date-time" },
        "sampctl_version": { "type": "string" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sampctlDependency" }
        },
        "runtime": { "$ref": "#/$defs/sampctlRuntime" },
        "build": { "$ref": "#/$defs/sampctlBuild" },
        "pawnkit": {
          "$ref": "#/$defs/pawnkitLockExtension",
          "x-pawnkit-extension": true
        }
      },
      "additionalProperties": false
    },
    "sampctlDependency": {
      "type": "object",
      "required": ["user", "repo"],
      "properties": {
        "constraint": { "type": "string" },
        "resolved": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "integrity": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64}|commit:[0-9a-f]{7,40})$"
        },
        "site": { "type": "string" },
        "user": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "branch": { "type": "string" },
        "transitive": { "type": "boolean" },
        "required_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scheme": {
          "type": "string",
          "enum": ["plugin", "component", "includes", "filterscript"]
        },
        "local": { "type": "string" }
      },
      "additionalProperties": false,
      "if": { "required": ["local"] },
      "else": { "required": ["constraint", "resolved", "commit"] }
    },
    "sampctlRuntime": {
      "type": "object",
      "required": ["version", "platform", "runtime_type"],
      "properties": {
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "runtime_type": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/sampctlFile" }
        }
      },
      "additionalProperties": false
    },
    "sampctlFile": {
      "type": "object",
      "required": ["path", "size", "hash", "mode"],
      "properties": {
        "path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string" },
        "mode": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sampctlBuild": {
      "type": "object",
      "properties": {
        "compiler_version": { "type": "string" },
        "compiler_preset": { "type": "string" },
        "entry": { "type": "string" },
        "output": { "type": "string" },
        "output_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pawnkitLockExtension": {
      "type": "object",
      "required": ["schema_version", "resources"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "resources": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/resolvedResource" }
        }
      },
      "additionalProperties": false
    },
    "resolvedResource": {
      "type": "object",
      "required": [
        "package",
        "resource",
        "target",
        "url",
        "size",
        "checksum",
        "archive",
        "files"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^(plugin|component|includes|filterscript)://[^/]+/[^/]+$"
        },
        "resource": { "type": "string", "minLength": 1 },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9]+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/@]+(?:/|$)"
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "archive": {
          "type": "string",
          "enum": ["zip", "tar.gz", "file"]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/resolvedResourceFile" }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "archive": { "const": "file" } },
        "required": ["archive"]
      },
      "then": {
        "properties": { "files": { "maxItems": 1 } }
      }
    },
    "resolvedResourceFile": {
      "type": "object",
      "required": ["source", "destination", "size", "checksum"],
      "properties": {
        "source": { "$ref": "#/$defs/safeRelativePath" },
        "destination": { "$ref": "#/$defs/safeRelativePath" },
        "size": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "checksum": { "$ref": "#/$defs/checksum" }
      },
      "additionalProperties": false
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        { "not": { "pattern": "^\\.?$" } }
      ]
    },
    "legacyPawnKitLock": {
      "type": "object",
      "required": ["schemaVersion", "packages"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "manifestChecksum": { "$ref": "#/$defs/checksum" },
        "compiler": {
          "type": "object",
          "required": ["vendor", "version"],
          "properties": {
            "vendor": { "type": "string", "enum": ["pawn-lang", "openmultiplayer", "original-pawn"] },
            "version": { "type": "string" },
            "checksum": { "$ref": "#/$defs/checksum" }
          },
          "additionalProperties": false
        },
        "runtimeProfile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/legacyPackage" }
        }
      },
      "additionalProperties": false,
      "deprecated": true
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "legacyPackage": {
      "type": "object",
      "required": ["name", "resolved", "commit", "source", "kind"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "resolved": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "source": {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": { "type": "string", "enum": ["git", "archive", "local"] },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        },
        "checksum": { "$ref": "#/$defs/checksum" },
        "kind": {
          "type": "string",
          "enum": ["dependency", "dev-dependency", "plugin", "component", "includes", "filterscript"]
        },
        "platformArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform"],
            "properties": {
              "platform": { "type": "string" },
              "url": { "type": "string" },
              "path": { "type": "string" },
              "checksum": { "$ref": "#/$defs/checksum" }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": { "const": "archive" }
            }
          }
        }
      },
      "then": { "required": ["checksum"] }
    }
  }
}
