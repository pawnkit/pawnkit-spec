{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pawnkit.dev/pawn-diagnostic/v2/schema.json",
  "title": "Pawn diagnostic",
  "description": "Version 2 of the shared diagnostic wire format.",
  "type": "object",
  "required": ["schemaVersion", "code", "source", "severity", "message", "primary"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9_-]+$",
      "description": "Stable namespaced diagnostic code."
    },
    "source": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["error", "warning", "info", "hint"] },
    "message": { "type": "string", "minLength": 1 },
    "primary": { "$ref": "#/$defs/location" },
    "related": {
      "type": "array",
      "items": { "$ref": "#/$defs/relatedLocation" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "help": { "type": "string" },
    "docsUrl": { "type": "string", "format": "uri" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "safeFixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/safeFix" }
    },
    "reviewFixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewFix" }
    },
    "suppressed": { "$ref": "#/$defs/suppression" }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "object",
      "required": ["line", "character"],
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "byteSpan": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["uri", "span"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/byteSpan" },
        "range": { "$ref": "#/$defs/range" }
      },
      "additionalProperties": false
    },
    "relatedLocation": {
      "type": "object",
      "required": ["location", "message"],
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textEdit": {
      "type": "object",
      "required": ["span", "newText"],
      "properties": {
        "span": { "$ref": "#/$defs/byteSpan" },
        "newText": { "type": "string" }
      },
      "additionalProperties": false
    },
    "documentEdit": {
      "type": "object",
      "required": ["uri", "edits"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "version": { "type": "integer" },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/textEdit" }
        }
      },
      "additionalProperties": false
    },
    "workspaceEdit": {
      "type": "object",
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/documentEdit" }
        }
      },
      "additionalProperties": false
    },
    "safeFix": {
      "type": "object",
      "required": ["message", "kind", "edit"],
      "properties": {
        "message": { "type": "string" },
        "kind": { "const": "safe" },
        "edit": { "$ref": "#/$defs/workspaceEdit" }
      },
      "additionalProperties": false
    },
    "reviewFix": {
      "type": "object",
      "required": ["message", "kind", "edit"],
      "properties": {
        "message": { "type": "string" },
        "kind": { "const": "review-required" },
        "edit": { "$ref": "#/$defs/workspaceEdit" }
      },
      "additionalProperties": false
    },
    "suppression": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
